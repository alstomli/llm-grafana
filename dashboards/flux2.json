{
  "uid": "flux2-inference",
  "title": "FLUX.2 · Image Generation & GPU",
  "description": "Dedicated BF16 image backend. Readiness and GPU telemetry complement the enforced no-offload runtime checks. Images are retained in the owner browser; backend job/output TTL is 24 hours.",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "flux2",
    "runpod",
    "images"
  ],
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "Image Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=\"flux2\"}, instance)",
        "query": {
          "query": "label_values(up{job=\"flux2\"}, instance)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Metrics connection",
      "description": "Current protected scrape status. No data is distinct from zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=\"flux2\",instance=\"${pod}\"}",
          "refId": "A",
          "legendFormat": "Metrics connection",
          "instant": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
